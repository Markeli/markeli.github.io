---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
	items.length >= 3 && (
		<details class="toc">
			<summary>Contents</summary>
			<ul>
				{items.map((h) => (
					<li class={`depth-${h.depth}`}>
						<a href={`#${h.slug}`}>{h.text}</a>
					</li>
				))}
			</ul>
		</details>
	)
}
<style>
	.toc {
		margin: 0 0 2em 0;
		font-size: 0.9em;
	}
	summary {
		cursor: pointer;
		color: rgb(var(--gray));
	}
	summary:hover {
		color: var(--accent);
	}
	ul {
		margin: 0.5em 0 0 0;
		padding: 0;
		list-style: none;
	}
	li {
		margin: 0.25em 0;
	}
	li::before {
		content: '> ';
		color: rgb(var(--gray));
	}
	.depth-3 {
		padding-left: 2ch;
	}
	a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
</style>
