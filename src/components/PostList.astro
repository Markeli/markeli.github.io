---
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="empty">No posts yet. Stay tuned.</p>
	) : (
		<ul class="posts">
			{posts.map((post) => (
				<li>
					<a class="title" href={`/blog/${post.id}/`}>
						{post.data.title}
						{post.data.draft && <span class="draft">[draft]</span>}
					</a>
					<p class="meta">
						<FormattedDate date={post.data.pubDate} /> · {readingTime(post.body)} min read
					</p>
					<p class="description">{post.data.description}</p>
					<TagList tags={post.data.tags} />
				</li>
			))}
		</ul>
	)
}
<style>
	.posts {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.posts li {
		margin-bottom: 2em;
	}
	.title {
		font-size: 1.25em;
		font-weight: 700;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.title:hover {
		color: var(--accent);
	}
	.meta,
	.description {
		margin: 0;
	}
	.meta {
		color: rgb(var(--gray));
		font-size: 0.8em;
	}
	.draft {
		margin-left: 0.5em;
		color: var(--accent);
		font-size: 0.7em;
		font-weight: 400;
		vertical-align: middle;
	}
	.empty {
		color: rgb(var(--gray));
	}
</style>
