---
import { CV_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Search from './Search.astro';
import SocialLinks from './SocialLinks.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<h2>
			<a href="/" class="brand">
				<svg class="mark" viewBox="16 16 88 88" width="24" height="24" aria-hidden="true">
					<path d="M85.5 34.5 A36 36 0 1 0 85.5 85.5" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round" />
					<circle cx="64" cy="60" r="10" fill="currentColor" />
				</svg>
				{SITE_TITLE}
			</a>
		</h2>
		<div class="internal-links" id="nav-links">
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/tags">Tags</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a href={CV_URL} target="_blank" rel="noopener">CV</a>
		</div>
		<div class="actions">
			<Search />
			<ThemeToggle />
			<div class="social">
				<SocialLinks />
			</div>
			<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
				<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
					<path class="bars" d="M3 6h18M3 12h18M3 18h18" />
					<path class="cross" d="M5 5l14 14M19 5L5 19" />
				</svg>
			</button>
		</div>
	</nav>
</header>
<script>
	const nav = document.querySelector('header nav');
	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const setOpen = (open: boolean) => {
		nav?.toggleAttribute('data-open', open);
		toggle?.setAttribute('aria-expanded', String(open));
	};
	toggle?.addEventListener('click', () => setOpen(!nav?.hasAttribute('data-open')));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && nav?.hasAttribute('data-open')) {
			setOpen(false);
			toggle?.focus();
		}
	});
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: rgb(var(--bg));
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.mark {
		flex-shrink: 0;
		color: var(--accent);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.menu-toggle {
		display: none;
		padding: 0.5em;
		border: none;
		background: none;
		color: rgb(var(--black));
		cursor: pointer;
	}
	.menu-toggle svg {
		display: block;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}
	.menu-toggle .cross,
	.menu-toggle[aria-expanded='true'] .bars {
		display: none;
	}
	.menu-toggle[aria-expanded='true'] .cross {
		display: inline;
	}
	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
		}
		h2 {
			flex: 1;
		}
		.social {
			display: none;
		}
		.menu-toggle {
			display: block;
		}
		.internal-links {
			display: none;
			order: 1;
			flex-basis: 100%;
			flex-direction: column;
			padding-bottom: 0.5em;
			border-top: 1px solid rgb(var(--gray-light));
		}
		nav[data-open] .internal-links {
			display: flex;
		}
		.internal-links a {
			padding: 0.5em 0;
			border-bottom: none;
		}
		.internal-links a::before {
			content: '> ';
			color: rgb(var(--gray));
		}
		.internal-links a.active {
			color: var(--accent);
		}
		.internal-links a.active::before {
			color: var(--accent);
		}
	}
</style>
